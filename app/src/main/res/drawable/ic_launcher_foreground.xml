<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: new Cresca bars mark, inset into the adaptive
     safe zone so masks never clip it. Background layer is black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <bitmap
            android:src="@drawable/cresca_icon"
            android:gravity="fill" />
    </item>
</layer-list>
