<?xml version="1.0" encoding="utf-8"?>
<!-- Brand launch background (light): white surround matches the
     light-mode logo mark (@drawable/cresca_logo) and the Flutter boot
     bridge, so cold start has no flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FFFFFFFF" />
    </item>

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/cresca_logo" />
    </item>
</layer-list>
